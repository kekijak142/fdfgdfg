local function strip(k) return k:gsub("^DFInt",""):gsub("^DFFlag",""):gsub("FString",""):gsub("FLog",""):gsub("^FFlag",""):gsub("^DFint",""):gsub("^FInt","") end

local function applyFlags()
    if not setfflag then return end
    for raw,val in pairs({
        ["DFIntTargetTimeDelayFacctorTenths"] = _flags.tt,
        ["FIntInterpolationMaxDelayMSec"]     = _flags.interp,
        ["DFIntS2PhysicsSenderRate"]          = _flags.s2,
    }) do
        local ck = strip(raw)
        pcall(function()
            if getfflag(ck)~=nil then setfflag(ck,val) elseif getfflag(raw)~=nil then setfflag(raw,val) end
        end)
    end
end

