local function applyReact(tt, interp)
    local function strip(k) return k:gsub("^DFInt",""):gsub("^DFFlag",""):gsub("FString",""):gsub("FLog",""):gsub("^FFlag",""):gsub("^DFint",""):gsub("^FInt","") end
    task.spawn(function()
        local flags = { ["DFIntTargetTimeDelayFacctorTenths"] = tt, ["FIntInterpolationMaxDelayMSec"] = interp }
        local function apply()
            if not setfflag then return end
            for k,v in pairs(flags) do
                local ck = strip(k)
                pcall(function() if getfflag(ck)~=nil then setfflag(ck,v) elseif getfflag(k)~=nil then setfflag(k,v) end end)
            end
        end
        while true do apply() task.wait(20) end
    end)
end

