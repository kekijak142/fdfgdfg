Tabs.FreeWill:Section({ Title = "Auto directional kick. Rides the ball based on camera." })

local Camera = workspace.CurrentCamera
local freewillLoop = nil
local REACH_FW = 5
local HEIGHT_FW = 3.1 

local function getFreewillBall()
    local tps = workspace:FindFirstChild("TPSSystem")
    return tps and tps:FindFirstChild("TPS") or workspace:FindFirstChild("Ball")
end

local function directionalKick(hrp, ball)
    for i = 1, 25 do 
        fti(hrp, ball, 0)
        fti(hrp, ball, 1) 
    end
end

local function setFreewillState(state)
    if state then
        freewillLoop = RunService.Heartbeat:Connect(function()
            local char = lp.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local ball = getFreewillBall()
            if hrp and ball then
                hrp.AssemblyLinearVelocity = Vector3.zero
                local camLook = Camera.CFrame.LookVector
                hrp.CFrame = CFrame.new(
                    ball.Position + Vector3.new(0, HEIGHT_FW, 0), 
                    ball.Position + Vector3.new(camLook.X, HEIGHT_FW, camLook.Z)
                )
                if (hrp.Position - ball.Position).Magnitude <= REACH_FW then 
                    directionalKick(hrp, ball) 
                end
            end
        end)
    else
        if freewillLoop then freewillLoop:Disconnect(); freewillLoop = nil end
    end
end

Tabs.FreeWill:Toggle({
    Title = "Enable Freewill",
    Default = false,
    Callback = function(state) setFreewillState(state) end
})

