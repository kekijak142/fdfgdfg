Tabs.AvatarSteal:Section({ Title = "Enter a Username or User ID to steal avatar." })

local function forceWeldAccessory(accessory, char)
    local handle = accessory:FindFirstChild("Handle")
    if not handle then return end
    
    handle.Anchored = false
    handle.CanCollide = false
    handle.Massless = true
    
    local handleAttachment = handle:FindFirstChildOfClass("Attachment")
    local charPart = char:FindFirstChild("Head") 
    local charAttachment = nil
    
    if handleAttachment then
        for _, part in pairs(char:GetChildren()) do
            if part:IsA("BasePart") then
                local found = part:FindFirstChild(handleAttachment.Name)
                if found and found:IsA("Attachment") then
                    charPart = part
                    charAttachment = found
                    break
                end
            end
        end
    end
    
    accessory.Parent = char
    local weld = Instance.new("Weld")
    weld.Name = "AccessoryWeld"
    weld.Part0 = charPart
    weld.Part1 = handle
    
    if charAttachment and handleAttachment then
        weld.C0 = charAttachment.CFrame
        weld.C1 = handleAttachment.CFrame
    else
        if charPart.Name == "Head" then
            weld.C0 = CFrame.new(0, charPart.Size.Y / 2, 0)
            weld.C1 = CFrame.new(0, -handle.Size.Y / 2, 0)
        end
    end
    weld.Parent = handle
end

local function applyStolenAvatar(targetNameOrId)
    local char = lp.Character
    local humanoid = char and char:FindFirstChildOfClass("Humanoid")
    if not char or not humanoid then return end

    local successId, targetId = pcall(function() 
        return tonumber(targetNameOrId) or Players:GetUserIdFromNameAsync(targetNameOrId) 
    end)
    
    if not successId or not targetId then 
        WindUI:Notify({Title = "Error", Content = "Could not find user: " .. tostring(targetNameOrId), Duration = 3})
        return 
    end

    local successApp, appearanceModel = pcall(function()
        return Players:GetCharacterAppearanceAsync(targetId)
    end)

    if successApp and appearanceModel then
        for _, obj in pairs(char:GetChildren()) do
            if obj:IsA("Accoutrement") or obj:IsA("Accessory") then
                local handle = obj:FindFirstChild("Handle")
                if handle then handle.Transparency = 1 end
            elseif obj:IsA("Shirt") or obj:IsA("Pants") or obj:IsA("ShirtGraphic") or obj:IsA("BodyColors") then
                obj:Destroy() 
            end
        end

        for _, item in pairs(appearanceModel:GetChildren()) do
            if item:IsA("Accoutrement") or item:IsA("Accessory") then
                forceWeldAccessory(item, char)
            elseif item:IsA("Shirt") or item:IsA("Pants") or item:IsA("ShirtGraphic") or item:IsA("BodyColors") then
                item.Parent = char
            elseif item:IsA("Decal") and (item.Name == "face" or item.Name == "Face") then
                local head = char:FindFirstChild("Head")
                if head then
                    local currentFace = head:FindFirstChildOfClass("Decal")
                    if currentFace then currentFace:Destroy() end
                    item.Parent = head
                end
            end
        end
        WindUI:Notify({Title = "Success", Content = "Stole avatar! Force-welded successfully.", Duration = 3})
    else
        WindUI:Notify({Title = "Error", Content = "Failed to load appearance data.", Duration = 3})
    end
end

